# Copy to .env.local (git-ignored). Leave unset to run the site from the local seed data.
# Local Supabase (after `npx supabase start`, values from `npx supabase status`):
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Dev only: lets the local enquiry mock mirror submissions into the CMS (from `npx supabase status`).
SUPABASE_SERVICE_ROLE_KEY=

# Enquiry form backend (Google Apps Script web app URL, see apps-script/SETUP.md).
# Leave unset in development to use the built-in mock at /api/enquiry.
VITE_ENQUIRY_ENDPOINT=
